OPENCARE_ENV=development
OPENCARE_DEMO_MODE=true
OPENCARE_DATA_DIR=data
OPENCARE_REPORTS_DIR=reports
OPENCARE_ALLOW_CLOUD_LLM=false
# Production only: set to a unique secret with at least 32 characters.
# OPENCARE_SECRET_KEY=replace-with-a-strong-secret-key
# Production private mode only: required when OPENCARE_DEMO_MODE=false.
# OPENCARE_ACCESS_PASSWORD=replace-with-a-private-access-password
