OPENCARE_ENV=development
OPENCARE_DEMO_MODE=true
OPENCARE_VAULT_SOURCE=demo
OPENCARE_DATA_DIR=data
OPENCARE_PRODUCT_DB_PATH=data/opencare.sqlite3
OPENCARE_SOURCE_DIR=data/sources
OPENCARE_REPORTS_DIR=reports
# Public self-registration is disabled by default. Enable only on a controlled,
# operator-bootstrapped self-hosted instance.
OPENCARE_PUBLIC_REGISTRATION=false
OPENCARE_ALLOW_CLOUD_LLM=false
# Guarded chat defaults to the local deterministic demo. Do not set these in public demo mode.
OPENCARE_AGENT_MODE=demo
OPENCARE_AGENT_ALLOW_EXTERNAL_LLM=false
# Complete Responses endpoint URL only; no query string, fragment, or embedded credentials.
# Production operators should use HTTPS. HTTP is accepted only for explicit local development.
# OPENCARE_LLM_RESPONSES_URL=https://api.example.com/v1/responses
# OPENCARE_LLM_API_KEY=replace-with-an-operator-managed-secret
# OPENCARE_LLM_MODEL=replace-with-a-responses-compatible-model
# External mode sends compact vault context to the operator-configured endpoint.
# Optional self-hosted provider (Ollama): opt-in, deterministic by default,
# loopback-only by default; not clinical validation of any model output.
# OPENCARE_AGENT_MODE=ollama
# OPENCARE_OLLAMA_ENDPOINT=http://127.0.0.1:11434
# OPENCARE_OLLAMA_MODEL=replace-with-a-local-model-name
# OPENCARE_OLLAMA_TIMEOUT_SECONDS=15.0
# OPENCARE_OLLAMA_MAX_RESPONSE_BYTES=1000000
# Local file mode only:
# OPENCARE_VAULT_FILE=/vault/local-family-vault.json
# Production only: set to a unique secret with at least 32 characters.
# OPENCARE_SECRET_KEY=replace-with-a-strong-secret-key
# Production private mode only: required when OPENCARE_DEMO_MODE=false.
# OPENCARE_ACCESS_PASSWORD=replace-with-a-private-access-password
# OPENCARE_BOOTSTRAP_SECRET=replace-with-a-unique-32-character-or-longer-operator-secret
