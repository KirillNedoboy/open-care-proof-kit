OPENCARE_SECRET_KEY=replace-with-a-32-character-or-longer-secret-key
OPENCARE_ACCESS_PASSWORD=replace-with-a-strong-private-password
OPENCARE_BOOTSTRAP_SECRET=replace-with-a-unique-32-character-or-longer-operator-secret
# Optional controlled public account creation; the operator must bootstrap first.
OPENCARE_PUBLIC_REGISTRATION=false
OPENCARE_PRODUCT_DATA_DIR=./private/opencare-product-core
OPENCARE_BACKUP_DIR=./private/opencare-backups

# Safe provider defaults. Uncomment and fill a complete provider configuration
# only when the operator has reviewed the disclosure and consent boundary.
OPENCARE_ALLOW_CLOUD_LLM=false
OPENCARE_AGENT_MODE=demo
OPENCARE_AGENT_ALLOW_EXTERNAL_LLM=false
# OPENCARE_LLM_RESPONSES_URL=https://api.example.com/v1/responses
# OPENCARE_LLM_API_KEY=replace-with-an-operator-managed-secret
# OPENCARE_LLM_MODEL=replace-with-a-responses-compatible-model
# OPENCARE_OPENROUTER_API_KEY=replace-with-an-operator-managed-secret
# OPENCARE_OPENROUTER_MODEL=provider/model
# OPENCARE_OLLAMA_ENDPOINT=http://127.0.0.1:11434
# OPENCARE_OLLAMA_MODEL=local-model-name
# OPENCARE_OLLAMA_TIMEOUT_SECONDS=15.0
# OPENCARE_OLLAMA_MAX_RESPONSE_BYTES=1000000
